# ─────────────────────────────────────────────────────────────
#  CONFIGURACIÓN JELCOM ENVÍOS — copia este archivo como .env
#  y pega tus credenciales reales. NO subas el .env a internet.
# ─────────────────────────────────────────────────────────────

# Puerto del servidor backend
PORT=4000

# ---------- HÁBLAME (SMS) ----------
# Las sacas de ecare.hablame.co -> Desarrolladores
HABLAME_ACCOUNT=
HABLAME_API_KEY=
# Código corto o remitente (ej. 87130)
HABLAME_REMITENTE=
# URL base de la API (por defecto la v5)
HABLAME_API_URL=https://www.hablame.co/api/sms/v5

# ---------- META / WHATSAPP (para la Fase WhatsApp) ----------
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ID=
WA_IDIOMA=es

# ---------- BREVO (Correo, para la Fase Correo) ----------
BREVO_API_KEY=
BREVO_REMITENTE_NOMBRE=Cajasan
BREVO_REMITENTE_EMAIL=
